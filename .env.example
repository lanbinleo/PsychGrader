# Host port to bind (reverse proxy / Caddy / Nginx / Cloudflare Tunnel -> 127.0.0.1:8090)
HOST_PORT=8090

# Single-teacher login passcode (leave empty to skip login screen during local testing)
ADMIN_PASSCODE=tsinglan-psych

# HMAC signing secret for session token
APP_SECRET=replace-with-a-random-secret

# DeepSeek V4.1 API credentials (can also be configured in the web UI Settings modal)
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
